{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "functions": { "api/index.js": { "maxDuration": 30 } },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }],
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
