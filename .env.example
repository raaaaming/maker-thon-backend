# Local: copy to .env (never commit). Vercel: Project Settings -> Environment Variables.

SUPABASE_URL=https://aaoafikysgvmvicjnoig.supabase.co
SUPABASE_JWKS_URL=https://aaoafikysgvmvicjnoig.supabase.co/auth/v1/.well-known/jwks.json
# Server-only key (sb_secret_...). Bypasses RLS, so it must never reach the browser.
SUPABASE_SECRET_KEY=

# Board -> server: Authorization: Bearer <DEVICE_TOKEN>
DEVICE_TOKEN=
# Code a user enters in the app to link a toilet.
PAIRING_CODE=
DEVICE_ID=toilet-01

# Comma-separated frontend origins allowed by CORS.
ALLOWED_ORIGINS=https://maker-ton.vercel.app

# Optional: food-photo analysis
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Seconds without a board heartbeat before the app shows "offline" (default 75)
OFFLINE_AFTER_SEC=75

# Minutes after a session ends during which a user can claim it (default 10)
CLAIM_WINDOW_MIN=10
